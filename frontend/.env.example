# API 配置
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# 应用配置
VITE_APP_NAME=EKG Learning System
VITE_APP_VERSION=1.0.0

# 功能开关
VITE_ENABLE_3D_VISUALIZATION=true
VITE_ENABLE_ADVANCED_ANALYSIS=true
VITE_SHOW_MEDICAL_DISCLAIMER=true

# 分析配置
VITE_MAX_FILE_SIZE=10485760
VITE_SUPPORTED_FORMATS=csv,pdf

# 调试模式
VITE_DEBUG=false
