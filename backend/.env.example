# 数据库配置
DATABASE_URL=postgresql://ekg_user:ekg_password_2026@localhost:5432/ekg_learning

# API 配置
SECRET_KEY=your-secret-key-change-this-in-production-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 应用配置
DEBUG=true
LOG_LEVEL=info
APP_NAME=EKG Learning System
VERSION=1.0.0

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# EKG 分析配置
DEFAULT_SAMPLING_RATE=500  # Hz
MIN_HEART_RATE=40
MAX_HEART_RATE=200

# 邮件配置（可选）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password

# Redis 配置（可选，用于缓存）
REDIS_URL=redis://localhost:6379/0

# 监控配置（可选）
SENTRY_DSN=

# 医疗免责声明开关
SHOW_MEDICAL_DISCLAIMER=true
